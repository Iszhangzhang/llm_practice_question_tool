  {
    "id": "regex_choice_001",
    "title": "匹配数字字符的元字符",
    "type": "choice",
    "category": "正则表达式",
    "difficulty": "easy",
    "description": "在正则表达式中，哪个元字符表示匹配任意数字字符？",
    "options": [
      "A. \\w",
      "B. \\d",
      "C. \\s",
      "D. \\n"
    ],
    "correct_answer": "B",
    "explanation": "\\d 匹配任意数字字符（0-9），\\w 匹配字母数字下划线，\\s 匹配空白符，\\n 匹配换行符。",
    "knowledge_points": [
      "元字符",
      "字符类"
    ],
    "hint": "数字的英文是 digit"
  },
  {
    "id": "regex_choice_002",
    "title": "匹配非数字字符",
    "type": "choice",
    "category": "正则表达式",
    "difficulty": "easy",
    "description": "哪个元字符匹配除了数字以外的任意字符？",
    "options": [
      "A. \\d",
      "B. \\D",
      "C. \\w",
      "D. \\S"
    ],
    "correct_answer": "B",
    "explanation": "\\D 是大写形式，表示取反，匹配任意非数字字符。类似地，\\W 匹配非字母数字下划线，\\S 匹配非空白符。",
    "knowledge_points": [
      "元字符",
      "字符类"
    ],
    "hint": "大小写往往表示相反含义。"
  },
